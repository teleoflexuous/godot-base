; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Base"
config/version="0.1.0"
run/main_scene="res://scenes/game/game_root.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DebugLog="*res://autoloads/debug_log.gd"
DevMode="*res://autoloads/dev_mode.gd"
GameManager="*res://autoloads/game_manager.gd"
SceneManager="*res://autoloads/scene_manager.tscn"
AudioManager="*res://autoloads/audio_manager.gd"
AudioSettings="*res://autoloads/audio_settings.gd"
GraphicsSettings="*res://autoloads/graphics_settings.gd"
InputSettings="*res://autoloads/input_settings.gd"
CameraSettings="*res://autoloads/camera_settings.gd"
Analytics="*res://autoloads/analytics.gd"
GUIDE="*res://addons/guide/guide.gd"

[debug]

file_logging/enable_file_logging=true
settings/gdscript/always_track_call_stacks=true
gdscript/warnings/directory_rules={
"res://addons": 0,
"res://tests": 0
}
gdscript/warnings/unused_parameter=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/return_value_discarded=2
gdscript/warnings/missing_await=1
gdscript/warnings/integer_division=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/confusable_local_declaration=2
gdscript/warnings/get_node_default_without_onready=1
gdscript/warnings/onready_with_export=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/GameAnalytics/plugin.cfg", "res://addons/guide/plugin.cfg")

[importer_defaults]

texture={
&"compress/mode": 2,
&"detect_3d/compress_to": 2,
&"mipmaps/generate": true,
&"process/size_limit": 1024
}

